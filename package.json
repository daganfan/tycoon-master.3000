{
  "name": "tycoon-master-3000",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tycoon game about playing tycoon games.",
  "author": "Tycoon Master 3000",
  "main": "electron/main.cjs",
  "desktopName": "tycoon-master-3000.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "balance": "tsx scripts/balance.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "icons": "tsx scripts/icons.ts",
    "package:web": "npm run build && tsx scripts/package-web.ts",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --config electron/builder.yml",
    "desktop:build:dir": "npm run build && electron-builder --config electron/builder.yml --dir"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "break_eternity.js": "^2.2.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "sharp": "^0.35.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
